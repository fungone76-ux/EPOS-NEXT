# EPOS NEXT local runtime
EPOS_DEFAULT_WORLDPACK=resort_world
EPOS_DATA_DIRECTORY=runtime_data

# Renderer: EPOS connects to the local AUTOMATIC1111/Forge API.
EPOS_RENDER_MODE=a1111

# AUTOMATIC1111 / Forge local runtime
A1111_BASE_URL=http://127.0.0.1:7860
A1111_CHECKPOINT=cyberrealisticPony_v7.safetensors
A1111_TIMEOUT_SECONDS=300

# ComfyUI local runtime
EPOS_COMFYUI_ENDPOINT=
EPOS_COMFYUI_WS_ENDPOINT=

# A1111_CHECKPOINT controls the loaded model; this mirrors it in diagnostics.
EPOS_IMAGE_CHECKPOINT=cyberrealisticPony_v7.safetensors
EPOS_IMAGE_WIDTH=896
EPOS_IMAGE_HEIGHT=1152
EPOS_IMAGE_SAMPLER=DPM++ 2M
EPOS_IMAGE_SCHEDULER=Karras
EPOS_IMAGE_STEPS=24
EPOS_IMAGE_CFG=7
EPOS_IMAGE_QUALITY_LAYER=masterpiece,best quality

# EPOS NEXT language model configuration
# OpenAI Responses API. Secrets belong only in the uncommitted local .env.
EPOS_PRIMARY_LLM_PROVIDER=openai
EPOS_PRIMARY_LLM_BASE_URL=https://api.openai.com/v1
EPOS_PRIMARY_LLM_MODEL=gpt-5.6-terra
EPOS_PRIMARY_LLM_KEY_ENV=OPENAI_API_KEY

EPOS_SECONDARY_LLM_PROVIDER=
EPOS_SECONDARY_LLM_BASE_URL=
EPOS_SECONDARY_LLM_MODEL=
EPOS_SECONDARY_LLM_KEY_ENV=

EPOS_LLM_FALLBACK_ENABLED=false
EPOS_LLM_TIMEOUT_SECONDS=60

# Example secret-variable names that KEY_ENV may reference.
OPENAI_API_KEY=
GEMINI_API_KEY=
