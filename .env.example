# EPOS NEXT renderer configuration
# Select the renderer only in the local environment. No backend is hardcoded here.
EPOS_RENDER_MODE=

# AUTOMATIC1111 / Forge local runtime
A1111_BASE_URL=
A1111_CHECKPOINT=
A1111_TIMEOUT_SECONDS=

# ComfyUI local runtime
EPOS_COMFYUI_ENDPOINT=
EPOS_COMFYUI_WS_ENDPOINT=

# EPOS NEXT language model configuration
# Values are intentionally blank. Real models, endpoints and secrets belong only in local environment.
EPOS_PRIMARY_LLM_PROVIDER=
EPOS_PRIMARY_LLM_BASE_URL=
EPOS_PRIMARY_LLM_MODEL=
EPOS_PRIMARY_LLM_KEY_ENV=

EPOS_SECONDARY_LLM_PROVIDER=
EPOS_SECONDARY_LLM_BASE_URL=
EPOS_SECONDARY_LLM_MODEL=
EPOS_SECONDARY_LLM_KEY_ENV=

EPOS_LLM_FALLBACK_ENABLED=true
EPOS_LLM_TIMEOUT_SECONDS=

# Example secret-variable names that KEY_ENV may reference.
OPENAI_API_KEY=
GEMINI_API_KEY=
